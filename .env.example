# Токен от @BotFather
BOT_TOKEN=123456:replace-me
# Ваш Telegram ID (узнать: @userinfobot). Несколько через запятую.
OWNER_IDS=123456789

# Необязательно
# DB_PATH=data/bot.db
# GROUP_PER_MINUTE=20     # сообщений в рабочую группу в минуту (лимит Telegram)
# BROADCAST_RATE=15       # скорость рассылки, сообщений в секунду
# REQUEST_TIMEOUT=60      # таймаут запроса к Telegram, секунд
# PROXY=socks5://user:pass@host:1080   # если Telegram с сервера недоступен напрямую
# IPV4_ONLY=1            # ходить к Telegram только по IPv4 (0 разрешить IPv6)
