# ─── Telegram ────────────────────────────────────────────────────────────────
# Получить у @BotFather. НИКОГДА не коммитить реальный токен.
BOT_TOKEN=123456:REPLACE_ME

# Telegram user_id владельцев бота, через запятую. Полный доступ к Owner Panel.
OWNER_IDS=8243233601

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linkermor
POSTGRES_USER=linkermor
POSTGRES_PASSWORD=REPLACE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── Надёжность ──────────────────────────────────────────────────────────────
# Резервные копии базы: файл приходит владельцу в Telegram.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_DIR=backups

# Внешний сторож: бот дёргает адрес при каждой успешной проверке.
# Если сигналы прекратятся, внешняя служба поднимет тревогу — упавший
# бот сообщить о себе не может. Подойдёт healthchecks.io и подобные.
WATCHDOG_URL=

# Сообщать владельцу об ошибках в личку.
ERROR_NOTIFY=true

# ─── Приложение ──────────────────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=info
# text | json  (json — для продакшена и сбора логов)
LOG_FORMAT=text
# Язык системных текстов по умолчанию
DEFAULT_LANGUAGE=ru
